}
MAX_FILE_BYTES = 45 * 1024 * 1024
MAX_TOTAL_BYTES = 700 * 1024 * 1024
USER_AGENT = "PDF-layout-corpus-builder/2.0 (+https://github.com/piggydamn/translation_layoutrecovery)"

for p in [ROOT, PREVIEW_DIR, LICENSE_DIR, TMP_DIR, *PDF_DIRS.values()]:
    p.mkdir(parents=True, exist_ok=True)


def session() -> requests.Session:
    s = requests.Session()
    retry = Retry(
        total=5,
        connect=5,
        read=5,
        backoff_factor=1.0,
        status_forcelist=(429, 500, 502, 503, 504),
        allowed_methods=frozenset({"GET", "HEAD"}),
        respect_retry_after_header=True,
    )
    s.mount("https://", HTTPAdapter(max_retries=retry, pool_connections=10, pool_maxsize=10))
    s.mount("http://", HTTPAdapter(max_retries=retry, pool_connections=10, pool_maxsize=10))
    s.headers.update({"User-Agent": USER_AGENT, "Accept": "*/*"})
    return s

S = session()


@dataclass
class Candidate:
    source_group: str
    title: str
    url: str
    category: str
    license_name: str
    license_url: str
    source_page: str = ""


@dataclass
class Record:
