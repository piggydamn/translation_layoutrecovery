    category: str
    source_url: str
    source_page: str
    license_name: str
    license_url: str
    pages: int
    file_size_bytes: int
    sha256: str
    sampled_pages: int
    pages_with_images: int
    embedded_images: int
    vector_drawing_groups: int
    two_column_pages: int
    two_column_ratio: float
    render_check: str


def log(msg: str) -> None:
    print(msg, flush=True)


def safe_name(text: str, max_len: int = 115) -> str:
    text = html.unescape(text)
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
    text = re.sub(r"[^A-Za-z0-9._ -]+", "", text)
    text = re.sub(r"\s+", "_", text).strip("._-")
    return (text or "document")[:max_len]


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def download(candidate: Candidate) -> Path | None:
    key = hashlib.sha1(candidate.url.encode()).hexdigest()[:12]
    dest = TMP_DIR / f"{safe_name(candidate.source_group)}_{key}.pdf"
    if dest.exists() and dest.stat().st_size > 1000:
        return dest
    try:
        with S.get(candidate.url, stream=True, timeout=(20, 90), allow_redirects=True) as r:
            r.raise_for_status()
            ctype = (r.headers.get("content-type") or "").lower()
            clen = int(r.headers.get("content-length") or 0)
