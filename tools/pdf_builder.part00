ROOT = Path("out/pdf_layout_collection_50_v2")
PDF_DIRS = {
    "two_column_paper": ROOT / "01_two_column_papers",
    "multi_column_periodical": ROOT / "02_multi_column_periodicals",
    "image_rich_research": ROOT / "03_image_rich_research",
}
PREVIEW_DIR = ROOT / "previews"
LICENSE_DIR = ROOT / "licenses"
TMP_DIR = Path("out/.pdf_downloads")
TARGETS = {
    "full_circle": 10,
    "r_journal_issue": 5,
    "r_journal_article": 10,
    "plos": 10,
    "europe_pmc": 5,
