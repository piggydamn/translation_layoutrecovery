            out.append(Candidate(
                source_group='plos',
                title=str(title),
                url=f'https://journals.plos.org/plosone/article/file?id={doi}&type=printable',
                category='image_rich_research',
                source_page=f'https://journals.plos.org/plosone/article?id={doi}',
                license_name='Creative Commons Attribution 4.0',
                license_url='https://creativecommons.org/licenses/by/4.0/',
            ))
    except Exception as e:
        log(f'PLOS discovery failed: {e}')
    return out


def discover_arxiv_cc() -> list[Candidate]:
    atom = 'http://www.w3.org/2005/Atom'
    arxiv = 'http://arxiv.org/schemas/atom'
    ns = {'atom': atom, 'arxiv': arxiv}
    queries = ['cat:cs.CV', 'cat:cs.CL', 'cat:cs.RO', 'cat:eess.IV', 'cat:cs.GR', 'cat:cs.LG', 'cat:cs.AI']
    out: list[Candidate] = []
    seen: set[str] = set()
    for query in queries:
        params = {
            'search_query': query,
            'start': 0,
            'max_results': 250,
            'sortBy': 'submittedDate',
            'sortOrder': 'descending',
        }
        try:
            r = S.get('https://export.arxiv.org/api/query', params=params, timeout=(25, 120))
            r.raise_for_status()
            root = ET.fromstring(r.content)
            for entry in root.findall('atom:entry', ns):
                license_el = entry.find('arxiv:license', ns)
                license_url = (license_el.text or '').strip() if license_el is not None else ''
                if 'creativecommons.org/' not in license_url.lower():
                    continue
                title_el = entry.find('atom:title', ns)
                id_el = entry.find('atom:id', ns)
                title = re.sub(r'\s+', ' ', (title_el.text or 'arXiv paper')).strip() if title_el is not None else 'arXiv paper'
                source_page = (id_el.text or '').strip() if id_el is not None else ''
                source_page = source_page.replace('http://', 'https://', 1)
                pdf_url = ''
                for link in entry.findall('atom:link', ns):
                    href = link.attrib.get('href', '')
                    if link.attrib.get('title') == 'pdf' or link.attrib.get('type') == 'application/pdf':
                        pdf_url = href
                        break
                if not pdf_url and source_page:
                    pdf_url = source_page.replace('/abs/', '/pdf/') + '.pdf'
                pdf_url = pdf_url.replace('http://', 'https://', 1)
                if not pdf_url or pdf_url in seen:
                    continue
                seen.add(pdf_url)
                out.append(Candidate(
                    source_group='arxiv_cc',
                    title=title,
                    url=pdf_url,
                    category='two_column_article',
                    source_page=source_page,
                    license_name='Creative Commons license declared in arXiv metadata',
                    license_url=license_url,
                ))
            log(f'arXiv discovery {query}: cumulative {len(out)} Creative Commons candidates')
        except Exception as e:
            log(f'arXiv discovery failed for {query}: {e}')
        time.sleep(3.2)
    return out


def accept(c: Candidate, records: list[Record], hashes: set[str]) -> bool:
    if sum(r.file_size_bytes for r in records) >= MAX_TOTAL_BYTES:
        return False
    tmp = download(c)
    if not tmp:
        return False
    digest = sha256_file(tmp)
    if digest in hashes:
        return False
    a = analyze(tmp)
    if not a or not meets_threshold(a, c.source_group):
        log(f'SKIP layout threshold: {c.title[:90]}')
        return False
    next_id = len(records) + 1
    filename = f'{next_id:02d}_{safe_name(c.source_group)}_{safe_name(c.title)}.pdf'
    dest = DIRS[c.category] / filename
    shutil.copy2(tmp, dest)
    hashes.add(digest)
    render_preview(dest, 0, PREVIEWS / f'{next_id:02d}_first.png')
    render_preview(dest, max(1, a['pages'] // 3), PREVIEWS / f'{next_id:02d}_inner.png')
    records.append(Record(
        id=next_id,
        filename=str(dest.relative_to(ROOT)),
        title=c.title,
        source_group=c.source_group,
        category=c.category,
        source_page=c.source_page,
        source_url=c.url,
        license_name=c.license_name,
        license_url=c.license_url,
        pages=a['pages'],
        file_size_bytes=dest.stat().st_size,
        sha256=digest,
        sampled_pages=a['sampled_pages'],
        pages_with_images=a['pages_with_images'],
        embedded_images=a['embedded_images'],
        vector_drawing_groups=a['vector_drawing_groups'],
        two_column_pages=a['two_column_pages'],
        two_column_ratio=a['two_column_ratio'],
        render_check='first/middle/last passed',
    ))
    log(f'ACCEPT {next_id:02d}/50 [{c.source_group}] {c.title[:90]}')
    return True


def select(candidates: list[Candidate], target: int, records: list[Record], hashes: set[str]) -> int:
    got = 0
    for c in candidates:
        if got >= target or len(records) >= 50:
            break
        if accept(c, records, hashes):
            got += 1
    return got


def contact_sheet(kind: str, out: Path) -> None:
    files = sorted(PREVIEWS.glob(f'*_{kind}.png'))
    if not files:
        return
    cell_w, cell_h, cols = 260, 360, 5
    rows = (len(files) + cols - 1) // cols
    canvas = Image.new('RGB', (cols * cell_w, rows * cell_h), 'white')
    draw = ImageDraw.Draw(canvas)
    font = ImageFont.load_default()
    for i, f in enumerate(files):
        img = Image.open(f).convert('RGB')
        img.thumbnail((cell_w - 18, cell_h - 36))
        x = (i % cols) * cell_w + (cell_w - img.width) // 2
        y = (i // cols) * cell_h + 22
        canvas.paste(img, (x, y))
        draw.text(((i % cols) * cell_w + 8, (i // cols) * cell_h + 5), f.stem[:2], fill='black', font=font)
    canvas.save(out, quality=88, optimize=True)


def write_metadata(records: list[Record]) -> None:
    with (ROOT / 'manifest.csv').open('w', newline='', encoding='utf-8-sig') as f:
        writer = csv.DictWriter(f, fieldnames=list(asdict(records[0]).keys()))
        writer.writeheader()
        for r in records:
            writer.writerow(asdict(r))
    counts: dict[str, int] = {}
    for r in records:
        counts[r.source_group] = counts.get(r.source_group, 0) + 1
    total_pages = sum(r.pages for r in records)
    total_mib = sum(r.file_size_bytes for r in records) / 1024 / 1024
    readme = f'''# PDF 严格双栏/多栏测试集合 v3（50 份）

本批只保留自动抽样识别为真实双栏或多栏、并且具有图片或矢量图形的完整 PDF。所有文件保留原始完整页，不裁页、不重排。

## 组成

- Full Circle 完整多栏杂志：{counts.get('full_circle', 0)} 份
- arXiv 明示 Creative Commons 许可的完整双栏论文：{counts.get('arxiv_cc', 0)} 份

合计 {len(records)} 份、{total_pages} 页，PDF 源文件约 {total_mib:.1f} MiB。

## 验证

- 每份均通过 PyMuPDF 打开。
- 每份均实际渲染首页、中间页和末页。
- 抽样页面必须达到双栏/多栏阈值，同时包含嵌入图片或矢量图形信号。
- `two_column_ratio` 是抽样页面中识别出左右文本列的比例，用于机器筛选，不是人工标注真值。

## 目录

- `01_two_column_articles/`：完整双栏论文。
- `02_multi_column_periodicals/`：完整多栏杂志。
- `manifest.csv`：逐文件来源、许可、页数、SHA-256、图片和栏结构统计。
- `previews/contact_sheet_first_pages.jpg`：全部首页总览。
- `previews/contact_sheet_inner_pages.jpg`：全部内页总览，用于直接检查栏结构和图文混排。

## 许可

每份文件的来源页、直接下载地址和具体许可地址均记录在 `manifest.csv`。原作者、出版者及文件内许可声明保持不变；本集合不改变单份文件原有许可条件。
'''
    (ROOT / 'README_CN.md').write_text(readme, encoding='utf-8')
    (LICENSES / 'SOURCE_AND_LICENSE_NOTES.txt').write_text(
        'Full Circle: the publication states that shared PDF materials are Creative Commons Share Alike.\n'
        'arXiv: only records whose arXiv API metadata contains a Creative Commons license URL are included.\n'
        'The exact license URL, source page and source PDF URL are recorded per file in manifest.csv.\n',
        encoding='utf-8',
    )


def zip_tree(source: Path, dest: Path, pdf_only: bool = False) -> None:
    with zipfile.ZipFile(dest, 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=6) as z:
        files = source.rglob('*.pdf') if pdf_only else source.rglob('*')
        for p in sorted(files):
            if p.is_file():
                z.write(p, p.relative_to(source if pdf_only else source.parent))


def main() -> None:
    records: list[Record] = []
    hashes: set[str] = set()
    full_circle = discover_full_circle()
    arxiv_cc = discover_arxiv_cc()
    groups = [
        ('full_circle', full_circle),
        ('arxiv_cc', arxiv_cc),
    ]
    for group, candidates in groups:
        got = select(candidates, TARGETS[group], records, hashes)
        log(f'GROUP {group}: {got}/{TARGETS[group]}')
    if len(records) < 50:
        for group, candidates in [('arxiv_cc', arxiv_cc), ('full_circle', full_circle)]:
            accepted_urls = {r.source_url for r in records}
            for c in candidates:
                if len(records) >= 50:
                    break
                if c.url in accepted_urls:
                    continue
                if accept(c, records, hashes):
                    accepted_urls.add(c.url)
            if len(records) >= 50:
                break
    if len(records) != 50:
        raise RuntimeError(f'Only collected {len(records)} strict-layout PDFs; expected 50')
    contact_sheet('first', PREVIEWS / 'contact_sheet_first_pages.jpg')
    contact_sheet('inner', PREVIEWS / 'contact_sheet_inner_pages.jpg')
